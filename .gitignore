# Secrets and credentials: never commit these. Templates (.example / .template) stay tracked.
.env
.env.*
!.env.example
*.env
config/odoo.conf
secrets/
*.secret
*.secrets
credentials*.json
*credentials*.txt
service-account*.json
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.netrc
.pgpass

# Database dumps and backups can hold customer data and password hashes.
*.dump
*.sql
*.sql.gz
backups/

# Local tooling
__pycache__/
*.pyc
.python-version
data/nav_xsd/
