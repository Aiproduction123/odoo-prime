# Copy to .env. scripts/bootstrap.sh creates .env with generated passwords
# when it is missing. Do not commit .env.

POSTGRES_PASSWORD=change-me
ODOO_MASTER_PASSWORD=change-me
BLURBY_ADMIN_PASSWORD=change-me
HAGEN_EMPLOYEE_PASSWORD=change-me

# Cloudflare named tunnel "hagen-odoo" (https://erp.hagenbikes.com -> http://odoo:8069).
CLOUDFLARE_TUNNEL_TOKEN=change-me

# WooCommerce REST API consumer key and secret (HTTP Basic). Placeholders only.
# Stores are loaded inactive until Opening Inventory 2026 is applied.
BLURBY_WC_KEY=change-me
BLURBY_WC_SECRET=change-me
BLURBY_HU_WC_KEY=change-me
BLURBY_HU_WC_SECRET=change-me
HAGEN_WC_KEY=change-me
HAGEN_WC_SECRET=change-me

# rattaproff.ee multisite: WordPress user and application password (HTTP Basic
# on each site's /wp-json/wc/v3/). Placeholders only.
RATTAPROFF_WP_USER=change-me
RATTAPROFF_APP_PASSWORD=change-me
