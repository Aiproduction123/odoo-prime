<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_list_sellable" model="ir.ui.view">
        <field name="name">product.template.list.hagen.sellable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="hagen_sellable_qty" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_sellable" model="ir.ui.view">
        <field name="name">product.template.form.hagen.sellable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="hagen_sellable_qty" invisible="not is_storable"/>
            </xpath>
        </field>
    </record>
</odoo>
