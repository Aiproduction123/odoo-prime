<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_hagen" model="res.groups.privilege">
        <field name="name">Hagen Group</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_employee" model="res.groups">
        <field name="name">Workshop employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hagen"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('stock.group_stock_user')),
            (4, ref('mrp.group_mrp_user')),
        ]"/>
        <field name="comment">Sales, Inventory and Manufacturing only. No invoicing, accounting, supplier prices, costs or settings.</field>
    </record>

    <record id="group_office" model="res.groups">
        <field name="name">Office (all apps, costs and supplier prices)</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hagen"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_office'))]"/>
    </record>
</odoo>
